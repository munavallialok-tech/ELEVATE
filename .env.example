# Get an API key from Google AI Studio. Never commit your real key.
GEMINI_API_KEY=
# Gemini 4 Hydrogen is available through the Gemini API.
GEMINI_MODEL=gemini-4-hydrogen

# Official pretrained COCO-17 pose model; Ultralytics downloads it on first run.
YOLO_POSE_WEIGHTS=yolov8n-pose.pt
YOLO_CONFIDENCE=0.25
MAX_FRAME_WIDTH=960
